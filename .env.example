# CodeDNA frontend environment
# Point this at your Spring Boot backend base URL when it is ready.
# The mock API layer (src/lib/api.ts) ignores this until USE_MOCK is set to false.
VITE_API_BASE_URL=/api/v1

# Optional: WebSocket endpoint for real-time analysis progress
VITE_WS_URL=ws://localhost:8080/ws

# Optional: GitHub OAuth (frontend only needs the client id + redirect)
VITE_GITHUB_CLIENT_ID=Ov23liozfUubDI7kfWVD
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth-callback.html
